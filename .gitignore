config/flow.log
config/flow.log.1
*.tmp

# tests : modules téléchargés au besoin
tests/.modules/

# refus mémorisés (propres à chaque machine)
config/claudemd-refuse.json

config/team-prefs.json

# installateur compilé
installer/sortie/

# mesures du banc de qualité (propres à chaque machine)
bench/resultats.jsonl
